# ── Python (tools/build.py) ──────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Build-Artefakte / temporäre Ausgaben ─────────────────────────
# Hinweis: grapple/index.html ist das gebaute Artefakt und wird NICHT
# versioniert (siehe grapple/.gitignore). Es entsteht beim Push auf main
# über .github/workflows/pages.yml (GitHub Pages) und lokal mit
# `python3 grapple/tools/build.py`. Die Wurzel-index.html dagegen IST
# versioniert — sie ist kein Artefakt, sondern der Pages-Einstiegspunkt
# (Weiterleitung auf grapple/index.html).
dist/
build/
out/
tmp/
*.tmp
*.bak
*.log

# ── Browser-Test-Artefakte (tools/test_browser.js, probe_*.js) ───
screenshots/
test-results/
playwright-report/
coverage/

# ── Umgebungsvariablen / Secrets ─────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
